                "test": "equals",
                "value": "Duct Fittings"
              }
            ]
          },
          {
            "name": "MEC - Elementos de ducto",
            "conditions": [
              {
                "tab": "Element",
                "property": "Category",
                "test": "equals",
                "value": "Duct Accessories"
              }
            ]
          },
          {
            "name": "MEC - Equipos",
            "conditions": [
              {
                "tab": "Element",
                "property": "Category",
                "test": "equals",
                "value": "Mechanical Equipment"
              }
            ]
          }
        ]
      },
      {
        "folder": "PLU",
        "scope_model_contains": "-PLU-",
        "_comment": "Hidrosanitario: tubería y sus accesorios.",
        "sets": [
          {

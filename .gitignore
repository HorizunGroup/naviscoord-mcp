# Local MCP registration: the paths in it are specific to one machine.
# Ship .mcp.json.example instead.
.mcp.json

# Build output
bin/
obj/
# Per-Navisworks-version output produced by installer\Build-Stage.ps1. One
# folder per version because a DLL compiled against the 2024 API is a
# different binary from the 2026 one and sharing bin\ makes the last build
# overwrite the previous one right before it is staged.
addin/_build/
*.dll
*.pdb
*.user
*.suo

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Model exports, analysis output and reports. These come from real projects
# and may carry client geometry, element ids and coordinates — never commit
# them to a public repository.
*.nwc
*.nwd
*.nwf
*.rvt
*.ifc
*_export.json
schema*.json
coordination_handoff.json
revit_worklist.json
fct_issues.csv
brg_issue_elements.csv
dim_*.csv
*.pdf

# Runtime del asistente. `.claude/` puede contener configuración del proyecto
# que sí vale la pena versionar, así que se ignora lo que es estado de una
# máquina concreta, no la carpeta entera. `scheduled_tasks.lock` llegó a estar
# versionado con un UUID de sesión y un PID dentro: no es fuente de nada y
# ninguna regla del job de higiene lo detectaba.
.claude/scheduled_tasks.lock
.claude/*.lock
.claude/shell-snapshots/
.claude/todos/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
installer/stage/
installer/Output/

# Efímeros de CI y de las verificaciones locales. Cada uno nace y muere en un
# run; si alguno aparece en `git status` es que un script terminó mal, y
# versionarlo dejaría dentro un log con rutas de la máquina.
degraded_driver.py
degraded.jsonl
*.staging-*
.naviscoord-sandbox
.naviscoord-selftest
.naviscoord-repro
.naviscoord-build-workspace
